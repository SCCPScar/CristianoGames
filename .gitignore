node_modules/
dist/
.DS_Store
*.log

# Capacitor native build output (the android/ios project folders
# themselves are committed on purpose — see Capacitor's own guidance)
android/app/build/
android/.gradle/
android/local.properties
# Synced web build copy — regenerated by `npx cap sync`, no need to track.
android/app/src/main/assets/public/
ios/App/Pods/
ios/App/build/

# Backend (Flask): the SQLite file (Flask puts it under instance/ by
# default) is local dev/demo data, and the venv is regenerated from
# requirements.txt — neither belongs in git.
backend/instance/
backend/.venv/
backend/__pycache__/

